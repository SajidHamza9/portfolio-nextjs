# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored (.gitignore -> .env*); this .env.example is committed as documentation.

# Resend (https://resend.com) — API key for sending the contact email.
RESEND_API_KEY=

# Recipient inbox for contact submissions (optional; defaults to sajidhaamza@gmail.com in code).
CONTACT_TO_EMAIL=

# Sender address — must be at a domain VERIFIED in Resend (e.g. contact@yourdomain.com).
# Format: "Display Name <address@yourdomain.com>". Leave unset to use the resend.dev sandbox sender.
CONTACT_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>

# reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Site key is public (exposed to the browser); secret key is server-only — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
